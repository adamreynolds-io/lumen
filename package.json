{
  "name": "lumen",
  "version": "0.1.0",
  "description": "Developer wallet for Midnight blockchain",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "tsx test/wallet.test.ts",
    "localnet:up": "docker compose up -d",
