# Lumen Localnet Environment Configuration
# Copy this file to .env and update values as needed

# APP_INFRA_SECRET
# A hex-encoded 32-byte secret used by the indexer-standalone to encrypt sensitive data.
# Generate with: openssl rand -hex 32
# Example: APP_INFRA_SECRET=a1b2c3d4e5f6...
APP_INFRA_SECRET=
